{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "node scripts/install_standalone.mjs",
  "buildCommand": "node scripts/verify_standalone_env.mjs && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/auth-api/:path*",
      "destination": "https://elynuzxnvjzypjgzkemc.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/((?!assets/|auth-api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/auth-api/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, max-age=0"},
        {"key": "CDN-Cache-Control", "value": "no-store"},
        {"key": "Vercel-CDN-Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(version|asset-history)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
